# ~/.bash_profile — bash login shells. zsh is the default shell on macOS; this
# exists so the occasional bash session (scripts, `bash -l`, SSH into this Mac
# from a bash-defaulted host) feels the same. Everything lives in bashrc.
# shellcheck source=/dev/null  # runtime file, not in the repo
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
