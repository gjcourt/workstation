# ~/.gitconfig (symlinked from workstation/git/config).
# Identity and anything machine-specific live in ~/.gitconfig.local, created by
# install.sh and included at the end so it can override anything above.

[core]
	autocrlf = input          # normalise CRLF to LF on commit; never convert on checkout
	# Global ignores: ~/.config/git/ignore (git's default path; see git/ignore).

[init]
	defaultBranch = main

[color]
	ui = auto

[pull]
	ff = only                 # never create surprise merge commits on pull

[push]
	default = current         # push the current branch to a same-named remote branch
	autoSetupRemote = true    # first push sets upstream; no -u needed

[fetch]
	prune = true              # drop remote-tracking branches deleted upstream

[rebase]
	autoStash = true

[diff]
	algorithm = histogram

[alias]
	s   = status
	b   = branch --sort=-committerdate          # most recently used first
	ds  = diff --staged
	lg  = log --oneline --graph --decorate -20
	# Default-branch-aware aliases: `git default` prints this repo's default
	# branch — origin's HEAD if known, else whichever of main/master exists — so
	# none of the aliases below hard-code a branch name. `git default upstream`
	# asks another remote.
	default = "!f() { r=${1:-origin}; b=$(git symbolic-ref --quiet --short refs/remotes/$r/HEAD 2>/dev/null); b=${b#$r/}; if [ -z \"$b\" ]; then for c in main master; do if git show-ref --verify --quiet refs/remotes/$r/$c || git show-ref --verify --quiet refs/heads/$c; then b=$c; break; fi; done; fi; [ -n \"$b\" ] || { echo 'git default: no main/master found' >&2; return 1; }; echo \"$b\"; }; f"
	dm  = "!git diff \"$(git default)\""                                       # working tree vs default branch
	dms = "!git diff \"$(git default)\" --stat"
	cmp = "!d=$(git default) && git checkout \"$d\" && git pull"              # back to default branch, up to date
	fr  = "!d=$(git default) && git fetch origin \"$d\" && git rebase \"origin/$d\""      # rebase onto latest origin default
	fru = "!d=$(git default upstream) && git fetch upstream \"$d\" && git rebase \"upstream/$d\""   # …or a fork's upstream
	up  = fr                                                                     # alias for fr

# GitHub over HTTPS authenticates through the gh CLI (`gh auth login`).
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[include]
	path = ~/.gitconfig.local
