# ~/.zshrc — interactive shells. Loaded after zshenv and (for login shells)
# zprofile. Each concern lives in its own file under $WORKSTATION_DIR/zsh/;
# this file wires them together, then hands over to ~/.zshrc.local.

# --- behaviour ---------------------------------------------------------------

bindkey -e                       # emacs keys: ^A ^E ^R ^W …

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY          # timestamp each entry
setopt SHARE_HISTORY             # share history live across open shells
setopt HIST_IGNORE_ALL_DUPS      # keep only the newest copy of a command
setopt HIST_IGNORE_SPACE         # a leading space keeps a command out of history
setopt HIST_REDUCE_BLANKS

setopt AUTO_CD                   # type a directory name to cd into it
setopt INTERACTIVE_COMMENTS      # allow # comments at the prompt
setopt NO_BEEP

# --- modules -----------------------------------------------------------------

for f in prompt aliases completion secrets; do
  source "$WORKSTATION_DIR/zsh/$f.zsh"
done
unset f

# direnv: per-directory .envrc files (only if installed).
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"

# --- local -------------------------------------------------------------------

# Machine-specific settings that must never be committed (hosts, work env).
# Created empty by install.sh.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
