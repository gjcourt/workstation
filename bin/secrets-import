#!/usr/bin/env python3
"""secrets-import — move `export NAME=value` secrets from a shell rc file into
1Password, and write the on-demand map that zsh/secrets.zsh reads.

    bin/secrets-import                      # from ~/.zshrc into the Private vault
    bin/secrets-import --dry-run            # list what would be imported; touch nothing
    bin/secrets-import --from ~/.zprofile --vault Private

For each secret-looking export (NAME contains TOKEN, SECRET, PASSWORD, PASS,
KEY or PRIVATE) it:
  1. evaluates the value with zsh, exactly as your shell would (quotes,
     escapes, $expansions) — the value is never printed or put on a command
     line;
  2. creates a 1Password "API Credential" item `workstation-NAME` in the vault,
     value in its `credential` field (existing items are left untouched);
  3. adds `NAME=op://<vault>/workstation-NAME/credential` to the map
     (~/.config/workstation/secrets.env, mode 600).

It never edits the rc file. After checking `secrets-list` / `secret NAME`, remove
the plaintext lines yourself — and delete the install.sh backup of the old rc
file, which still contains them.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile

SECRETISH = re.compile(r"(TOKEN|SECRET|PASSWORD|PASS|KEY|PRIVATE)")
EXPORT = re.compile(r"^\s*export\s+([A-Za-z_][A-Za-z0-9_]*)=")
# Names that point AT a secret (a path) rather than holding one — e.g.
# SOPS_AGE_KEY_FILE. Not imported; they belong in ~/.zshrc.local as plain config.
POINTER = re.compile(r"_(FILE|PATH|DIR)$")
# Exporting this one breaks Claude Code's own login (it overrides the stored
# credentials, and Remote Control refuses it) — so it's dropped, not imported.
SKIP = {"CLAUDE_CODE_OAUTH_TOKEN": "overrides Claude Code's login; don't export it"}


def value_of(line, name):
    """Evaluate one export line in a clean zsh (-f: no rc files) and return the value."""
    script = f'{line}\nprint -rn -- "${{{name}}}"'
    out = subprocess.run(["zsh", "-f", "-c", script], capture_output=True, text=True, check=False)
    if out.returncode != 0:
        raise RuntimeError(f"zsh could not evaluate the {name} line")
    return out.stdout


def op(*args, **kw):
    return subprocess.run(["op", *args], capture_output=True, text=True, check=False, **kw)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--from", dest="src", default=os.path.expanduser("~/.zshrc"))
    ap.add_argument("--vault", default="Private")
    ap.add_argument(
        "--map",
        default=os.path.expanduser(
            os.environ.get("WORKSTATION_SECRETS", "~/.config/workstation/secrets.env")
        ),
    )
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    found = {}  # name -> export line; last definition wins, as in the shell
    with open(args.src, encoding="utf-8") as fh:
        for line in fh:
            m = EXPORT.match(line)
            if m and SECRETISH.search(m.group(1)):
                found[m.group(1)] = line.rstrip("\n")

    for name in sorted(n for n in found if POINTER.search(n)):
        del found[name]
        print(f"keep    {name}: a path, not a secret — move it to ~/.zshrc.local as-is")

    if not found:
        print(f"No secret-looking exports in {args.src}.")
        return 0

    for name, why in SKIP.items():
        if found.pop(name, None) is not None:
            print(f"skip    {name}: {why}")

    if args.dry_run:
        for name in sorted(found):
            print(f"would   {name} -> op://{args.vault}/workstation-{name}/credential")
        return 0

    if op("whoami").returncode != 0:
        print("1Password CLI isn't signed in — run `op signin` first")
        print("(or turn on the 1Password app's CLI integration).")
        return 1

    os.makedirs(os.path.dirname(args.map), exist_ok=True)
    existing = {}
    if os.path.exists(args.map):
        with open(args.map, encoding="utf-8") as fh:
            for ln in fh:
                if "=" in ln and not ln.startswith("#"):
                    k, v = ln.rstrip("\n").split("=", 1)
                    existing[k] = v

    failed = 0
    for name in sorted(found):
        title = f"workstation-{name}"
        ref = f"op://{args.vault}/{title}/credential"
        if op("item", "get", title, "--vault", args.vault).returncode == 0:
            print(f"exists  {name}: 1Password item '{title}' already there — left as is")
            existing[name] = ref
            continue
        try:
            value = value_of(found[name], name)
        except RuntimeError as exc:
            print(f"FAIL    {name}: {exc}")
            failed += 1
            continue
        template = {
            "title": title,
            "category": "API_CREDENTIAL",
            "tags": ["workstation"],
            "fields": [
                {"id": "credential", "type": "CONCEALED", "label": "credential", "value": value}
            ],
        }
        # The value goes to op via a private temp file, never argv (visible in `ps`).
        fd, path = tempfile.mkstemp(prefix="secrets-import-", suffix=".json")
        try:
            with os.fdopen(fd, "w") as fh:
                json.dump(template, fh)
            res = op("item", "create", "--vault", args.vault, "--template", path)
        finally:
            os.unlink(path)
        if res.returncode != 0:
            print(f"FAIL    {name}: op item create failed: {res.stderr.strip()[:200]}")
            failed += 1
            continue
        existing[name] = ref
        print(f"import  {name} -> {ref}")

    with open(args.map, "w", encoding="utf-8") as fh:
        fh.write("# NAME=op://vault/item/field — read by zsh/secrets.zsh. Not a secret itself.\n")
        for k in sorted(existing):
            fh.write(f"{k}={existing[k]}\n")
    os.chmod(args.map, 0o600)
    print(f"\nMap: {args.map} ({len(existing)} entries).")
    print("Check with `secrets-list` and `secret NAME`,")
    print(f"then remove the plaintext export lines from {args.src}.")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
